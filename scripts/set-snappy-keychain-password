#!/usr/bin/env bash

set -e

__set_snappy_keychain_password_main() {
    local password_file password

    password_file="${HOME}/.ssh/snappy-keychain-password"
    mkdir -p "$(dirname "$password_file")"
    chmod 700 "$(dirname "$password_file")"

    read -r -s -p 'Snappy login keychain password: ' password
    echo
    if [[ -z "$password" ]]; then
        echo 'Password was empty; nothing changed.' >&2
        return 1
    fi

    umask 077
    printf '%s\n' "$password" > "$password_file"
    unset password
    echo "Saved to $password_file"
}

__set_snappy_keychain_password_main "$@"
unset -f __set_snappy_keychain_password_main
