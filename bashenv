# bashenv — equivalent of zshenv for bash. Bash does NOT auto-source any
# such file for non-interactive shells, so this only takes effect when
# BASH_ENV is explicitly set, e.g.:
#   - sshd_config: SetEnv BASH_ENV=/home/USER/.bashenv  (newer OpenSSH)
#   - sshd_config: PermitUserEnvironment=yes + ~/.ssh/environment
#   - /etc/environment (system-wide)
#
# Note: bash also has a quirk where it DOES source ~/.bashrc when invoked
# non-interactively by sshd (stdin = network socket). Our bashrc sources
# shenv at the top, so for the common `ssh host 'cmd'` case bash gets the
# full env via that path even without BASH_ENV. This file is the explicit
# fallback for everything else (cron, scp, etc.).

__bashenv_main() {
    local SH_SOURCE_FILE SH_SOURCE_DIR

    SH_SOURCE_FILE=${BASH_SOURCE[0]}
    while [[ -L "$SH_SOURCE_FILE" ]]; do
        SH_SOURCE_FILE=$(readlink "$SH_SOURCE_FILE")
    done

    SH_SOURCE_DIR=$(dirname "$SH_SOURCE_FILE")
    SH_SOURCE_DIR=$(
        cd "$SH_SOURCE_DIR" >/dev/null
        pwd
    )

    if [[ -f "$SH_SOURCE_DIR/shenv" ]]; then
        . "$SH_SOURCE_DIR/shenv"
    fi
}

__bashenv_main "$@"
unset -f __bashenv_main
