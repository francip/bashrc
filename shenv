# shenv — shared shell environment, sourced by zshenv/bashenv (always) and
# by zshrc/bashrc (idempotent — short-circuits if already loaded).
#
# Holds env setup that must be available to BOTH interactive and
# non-interactive shells: PATH, language toolchains (nvm/conda/uv/cargo/...),
# ssh-agent socket discovery, locale.
#
# Anything interactive-only (prompt, completion, MOTD, tmux auto-attach,
# aliases, shell-local rc hooks) belongs in zshrc/bashrc, NOT here.
#
# Why this exists: zshrc is not sourced for non-interactive zsh, and bashrc
# is sourced inconsistently for non-interactive bash. Without a shared env
# file, `ssh host 'cmd'` runs without nvm/conda/PATH set up.

if [[ -n "$_SHENV_LOADED" ]]; then
    return
fi

__shenv_main() {
    local SH_SOURCE_FILE

    if [[ -n "$ZSH_VERSION" ]]; then
        SH_SOURCE_FILE=${(%):-%x}
    elif [[ -n "$BASH_VERSION" ]]; then
        SH_SOURCE_FILE=${BASH_SOURCE[0]}
    fi

    while [[ -L "$SH_SOURCE_FILE" ]]; do
        SH_SOURCE_FILE=$(readlink "$SH_SOURCE_FILE")
    done

    local SH_SOURCE_DIR
    SH_SOURCE_DIR=$(dirname "$SH_SOURCE_FILE")
    SH_SOURCE_DIR=$(
        cd "$SH_SOURCE_DIR" >/dev/null
        pwd
    )

    # OS detection: source configure_os directly (vars become globals since
    # configure_os no longer uses 'local'). The heredoc-round-trip pattern
    # the rcs use breaks on `"$VAR"` lines because inner double-quotes
    # terminate the captured echo argument early — bash then sees `[ -n  ]`
    # which tests `-n` as a non-empty string and returns true incorrectly.
    if [[ -e "$SH_SOURCE_DIR/configure_os" ]]; then
        . "$SH_SOURCE_DIR/configure_os"
    fi
    export SH_OS_TYPE SH_OS_FLAVOR SH_OS_DISTRO SH_OS_DISTRO_NUM SH_OS_RELEASE

    # Define __sh_color_definitions globally so shrc_helpers and the rcs can
    # eval it. configure_colors has no `"$VAR"` patterns so the heredoc trick
    # is safe here. Stub __sh_os_definitions to silence shrc_helpers' eval.
    local SH_COLOR_DEFS
    if [[ -e "$SH_SOURCE_DIR/configure_colors" ]]; then
        SH_COLOR_DEFS=$(cat "$SH_SOURCE_DIR/configure_colors")
    fi

    eval "$(
        cat <<EOF
        __sh_color_definitions() {
            echo "$SH_COLOR_DEFS"
        }
        __sh_os_definitions() {
            :
        }
EOF
    )"

    # Helpers: __add_to_path, __add_to_cd_path, __include_files, ...
    if [[ -e "$SH_SOURCE_DIR/shrc_helpers" ]]; then
        . "$SH_SOURCE_DIR/shrc_helpers"
    fi

    # ---------------------------------------------------------------------------
    # SSH agent socket discovery (discover only — never start an agent here;
    # starting belongs in zshrc/bashrc behind an interactive guard)
    # ---------------------------------------------------------------------------
    case "$SH_OS_TYPE" in
        OSX)
            if [[ -z "$SSH_AUTH_SOCK" || ! -S "$SSH_AUTH_SOCK" ]]; then
                local _mac_sock
                # macOS 26+ moved sockets from /private/tmp to /var/run
                _mac_sock=$(find /private/tmp /var/run -path "*/com.apple.launchd.*/Listeners" -user "$USER" 2>/dev/null | head -1)
                [[ -S "$_mac_sock" ]] && export SSH_AUTH_SOCK="$_mac_sock"
            fi
            ;;
        Linux)
            if [[ -z "$SSH_AUTH_SOCK" || ! -S "$SSH_AUTH_SOCK" ]]; then
                local _ssh_sock
                _ssh_sock=$(find /tmp/ssh-* -name 'agent.*' -user "$USER" 2>/dev/null | head -1)
                [[ -S "$_ssh_sock" ]] && export SSH_AUTH_SOCK="$_ssh_sock"
            fi
            ;;
    esac

    # Add personal key (no-op if already added or agent unreachable). Runs in
    # all shells so git commit signing works in non-interactive contexts like
    # VS Code's built-in git.
    #
    # Skip on physical Linux VT consoles (autologin with no keyboard) where
    # ssh-add would block forever waiting on /dev/tty for a passphrase.
    if ! [[ -z $SSH_CONNECTION && $(tty 2>/dev/null) =~ ^/dev/tty[0-9]+$ ]]; then
        ssh-add >/dev/null 2>&1
        if [[ -f "${HOME}/.ssh/id_rsa_personal" ]]; then
            if [[ $(ssh-add -l 2>/dev/null | grep -i id_rsa_personal | wc -l) -lt 1 ]]; then
                if [[ "$SH_OS_TYPE" == OSX ]]; then
                    ssh-add --apple-use-keychain "${HOME}/.ssh/id_rsa_personal" >/dev/null 2>&1
                else
                    ssh-add "${HOME}/.ssh/id_rsa_personal" >/dev/null 2>&1
                fi
            fi
        fi
    fi

    # ---------------------------------------------------------------------------
    # Locale, editor
    # ---------------------------------------------------------------------------
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export EDITOR=vim

    # ---------------------------------------------------------------------------
    # Homebrew
    # ---------------------------------------------------------------------------
    # On macOS, run path_helper ourselves so /etc/paths and /etc/paths.d/*
    # contribute to PATH BEFORE we prepend our own dirs. /etc/zprofile would
    # otherwise run path_helper after us (login shells only) and shove
    # /usr/local/bin etc. to the front, mangling our ordering. We disable
    # that re-run via `setopt no_global_rcs` in zshenv.
    if [[ "$SH_OS_TYPE" == OSX && -x /usr/libexec/path_helper ]]; then
        eval "$(/usr/libexec/path_helper -s)"
    fi

    if [[ "$SH_OS_TYPE" == OSX && -f /opt/homebrew/bin/brew ]]; then
        export HOMEBREW_NO_ENV_HINTS=1
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ "$SH_OS_TYPE" == Linux && -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        export HOMEBREW_NO_ENV_HINTS=1
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi

    BREW_DIR=$(brew --prefix 2>/dev/null)
    export BREW_DIR

    # ---------------------------------------------------------------------------
    # Base PATH
    # ---------------------------------------------------------------------------
    local PATH_DIRS
    PATH_DIRS=("${HOME}/bin" "${HOME}/.local/bin" "${SH_SOURCE_DIR}/scripts")
    if [[ "$SH_OS_TYPE" == OSX ]]; then
        PATH_DIRS=("${PATH_DIRS[@]}" "${BREW_DIR}/bin" "/usr/local/bin" "/usr/local/sbin" "/opt/local/bin" "/opt/local/sbin")
    fi
    if [[ "$SH_OS_DISTRO" == Ubuntu ]]; then
        PATH_DIRS=("${PATH_DIRS[@]}" "/snap/bin")
    fi
    __add_to_path "${PATH_DIRS[@]}"

    # ---------------------------------------------------------------------------
    # VS Code
    # ---------------------------------------------------------------------------
    local VS_CODE_PATH_DIRS
    VS_CODE_PATH_DIRS=()
    if [[ "$SH_OS_TYPE" == OSX ]]; then
        VS_CODE_PATH_DIRS=(
            "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
            "${HOME}/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
        )
    elif [[ "$SH_OS_TYPE" == Linux ]]; then
        VS_CODE_PATH_DIRS=("/usr/share/code/bin")
        if [[ "$SH_OS_FLAVOR" == WSL ]]; then
            local __WSL_WIN_USER
            __WSL_WIN_USER=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
            if [[ -n "$__WSL_WIN_USER" ]]; then
                VS_CODE_PATH_DIRS=(
                    "${VS_CODE_PATH_DIRS[@]}"
                    "/mnt/c/Users/${__WSL_WIN_USER}/AppData/Local/Programs/Microsoft VS Code/bin"
                    "/mnt/c/Program Files/Microsoft VS Code/bin"
                )
            fi
        fi
    elif [[ "$SH_OS_TYPE" == Windows && -n "$USERNAME" ]]; then
        VS_CODE_PATH_DIRS=(
            "/c/Users/${USERNAME}/AppData/Local/Programs/Microsoft VS Code/bin"
            "/c/Program Files/Microsoft VS Code/bin"
        )
    fi
    if [[ ${#VS_CODE_PATH_DIRS[@]} -gt 0 ]]; then
        __add_to_path "${VS_CODE_PATH_DIRS[@]}"
    fi

    # ---------------------------------------------------------------------------
    # Claude
    # ---------------------------------------------------------------------------
    if [[ -d "$HOME/.claude/local" ]]; then
        __add_to_path "${HOME}/.claude/local"
    fi

    # ---------------------------------------------------------------------------
    # Android SDK / NDK
    # ---------------------------------------------------------------------------
    if [[ -d "$HOME/android-sdk" ]]; then
        export ANDROID_HOME="$HOME/android-sdk"
    fi

    if [[ -d "$HOME/Library/Android/sdk" ]]; then
        export ANDROID_HOME="$HOME/Library/Android/sdk"
    fi

    if [[ -n "$ANDROID_HOME" ]]; then
        __add_to_path "${ANDROID_HOME}/build-tools/$([[ -d "${ANDROID_HOME}/build-tools/" ]] && ls -1 "${ANDROID_HOME}/build-tools/" | tr -d '/' | sort -V | tail -n 1)" "${ANDROID_HOME}/platform-tools" "${ANDROID_HOME}/tools"
    fi

    if [[ -d "$HOME/android-ndk" ]]; then
        export ANDROID_NDK="$HOME/android-ndk"
    fi

    if [[ -d "$ANDROID_HOME/ndk" ]]; then
        export ANDROID_NDK="$ANDROID_HOME/ndk"
    fi

    if [[ -n "$ANDROID_NDK" ]]; then
        export ANDROID_NDK_REPOSITORY="$ANDROID_NDK"
        export ANDROID_NDK_ROOT="$ANDROID_NDK"
        export NDKROOT="$ANDROID_NDK"
        export NDK_MODULE_PATH="$ANDROID_NDK"
        __add_to_path "${ANDROID_NDK}/$([[ -d "${ANDROID_NDK}/" ]] && ls -1 "${ANDROID_NDK}/" | tr -d '/' | sort -V | tail -n 1)"
    fi

    # ---------------------------------------------------------------------------
    # Node (NVM)
    # ---------------------------------------------------------------------------
    if [[ -d "$HOME/.nvm" ]]; then
        export NVM_DIR="$HOME/.nvm"
    fi
    if [[ -d "$NVM_DIR" ]]; then
        if [[ -s "$NVM_DIR/nvm.sh" ]]; then
            . "$NVM_DIR/nvm.sh"
            # nvm.sh leaves "system" active by default; switch to nvm's default.
            # Interactive shells re-check this later in zshrc/bashrc, so a _local
            # hook can still override.
            nvm use default >/dev/null 2>&1
        fi
    fi

    # ---------------------------------------------------------------------------
    # Bun
    # ---------------------------------------------------------------------------
    if [[ -d "$HOME/.bun" ]]; then
        export BUN_INSTALL="$HOME/.bun"
    fi
    if [[ -d "$BUN_INSTALL" ]]; then
        __add_to_path "${BUN_INSTALL}/bin"
    fi

    # ---------------------------------------------------------------------------
    # Ruby
    # ---------------------------------------------------------------------------
    local SH_BREW_RUBY SH_DEFAULT_GEM_HOME
    if [[ "$SH_OS_TYPE" == OSX && -n "$BREW_DIR" ]]; then
        SH_BREW_RUBY="${BREW_DIR}/opt/ruby/bin/ruby"
        if [[ -x "$SH_BREW_RUBY" ]]; then
            __add_to_path "${BREW_DIR}/opt/ruby/bin"
            SH_DEFAULT_GEM_HOME=$($SH_BREW_RUBY -e 'require "rubygems"; print Gem.default_dir' 2>/dev/null)
        fi
    fi
    if [[ -z "$GEM_HOME" ]]; then
        if [[ -n "$SH_DEFAULT_GEM_HOME" && -d "$SH_DEFAULT_GEM_HOME" ]]; then
            export GEM_HOME="$SH_DEFAULT_GEM_HOME"
        elif [[ -d "$HOME/.gem" ]]; then
            export GEM_HOME="$HOME/.gem"
        elif [[ -d "$HOME/gems" ]]; then
            export GEM_HOME="$HOME/gems"
        fi
    fi
    if [[ -n "$GEM_HOME" ]]; then
        __add_to_path "${GEM_HOME}/bin"
    fi

    # ---------------------------------------------------------------------------
    # Go
    # ---------------------------------------------------------------------------
    if [[ "$SH_OS_TYPE" == OSX && -d "$HOME/go" ]]; then
        export GOPATH="$HOME/go"
    fi

    # ---------------------------------------------------------------------------
    # Conda
    # ---------------------------------------------------------------------------
    if [[ -x "$HOME/miniconda3/bin/conda" ]]; then
        local __conda_setup __conda_shell
        if [[ -n "$ZSH_VERSION" ]]; then
            __conda_shell=zsh
        else
            __conda_shell=bash
        fi
        __conda_setup="$("$HOME/miniconda3/bin/conda" "shell.${__conda_shell}" "hook" 2>/dev/null)"
        if [[ $? -eq 0 ]]; then
            eval "$__conda_setup"
        elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
            . "$HOME/miniconda3/etc/profile.d/conda.sh"
        else
            __add_to_path "${HOME}/miniconda3/bin"
        fi
    fi

    # ---------------------------------------------------------------------------
    # uv
    # ---------------------------------------------------------------------------
    if [[ -f "$HOME/.local/bin/env" ]]; then
        . "$HOME/.local/bin/env"
    fi

    # ---------------------------------------------------------------------------
    # Rust
    # ---------------------------------------------------------------------------
    if [[ -f "$HOME/.cargo/env" ]]; then
        . "$HOME/.cargo/env"
    fi

    # ---------------------------------------------------------------------------
    # CUDA
    # ---------------------------------------------------------------------------
    if [[ -d /usr/local/cuda/bin ]]; then
        __add_to_path "/usr/local/cuda/bin"
    fi
    if [[ "$SH_OS_DISTRO" == Ubuntu && -d /usr/local/cuda ]]; then
        export CUDA_HOME=/usr/local/cuda
        export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    fi

    # ---------------------------------------------------------------------------
    # llama.cpp
    # ---------------------------------------------------------------------------
    if [[ "$SH_OS_DISTRO" == Ubuntu ]]; then
        export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
    elif [[ "$SH_OS_TYPE" == OSX && -n "$BREW_DIR" ]]; then
        export OpenMP_ROOT="$BREW_DIR/opt/libomp"
    fi

    # ---------------------------------------------------------------------------
    # NVIDIA AI Workbench wrapper
    # ---------------------------------------------------------------------------
    if [[ -f "$HOME/.local/share/nvwb/nvwb-wrapper.sh" ]]; then
        . "$HOME/.local/share/nvwb/nvwb-wrapper.sh"
    fi

    # ---------------------------------------------------------------------------
    # WSL X
    # ---------------------------------------------------------------------------
    if [[ "$SH_OS_FLAVOR" == WSL ]]; then
        export GDK_DPI_SCALE=2
    fi
}

__shenv_main "$@"
unset -f __shenv_main
# Note: shell-local, NOT exported. Functions and helpers aren't inherited
# across processes, so each new shell needs to run shenv fresh.
_SHENV_LOADED=1
